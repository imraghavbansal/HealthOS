# ─── Atlas Health · frontend configuration ──────────────────────────────
# Copy to `.env` and fill in. Anything prefixed VITE_ is PUBLIC (shipped to
# the browser). Never put a secret behind a VITE_ prefix.

# "mock"     = fully working demo on in-memory data
# "supabase" = real, persisted data (see supabase/migrations/0001_init.sql)
VITE_API_MODE=mock

# Required when VITE_API_MODE=supabase. From your Supabase project's
# Settings → API. The anon key is safe to ship — RLS enforces access, this
# key alone grants nothing.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# ─── SERVER-ONLY (no VITE_ prefix; never referenced in browser code) ────
# Read these only inside a Supabase Edge Function — never in client code and
# never behind a VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=   # bypasses RLS — edge functions only
# ANTHROPIC_API_KEY=           # Ask Atlas + document parsing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITAL_API_KEY=               # wearable aggregation (tryvital.io)
# TERRA_API_KEY=               # alternative wearable aggregator
