# ─── Raag · frontend configuration ──────────────────────────────
# Copy to `.env` and fill in. Anything prefixed VITE_ is PUBLIC (shipped to
# the browser). Never put a secret behind a VITE_ prefix.

# "mock"     = fully working demo on in-memory data
# "supabase" = real, persisted data (see supabase/migrations/0001_init.sql)
VITE_API_MODE=mock

# Required when VITE_API_MODE=supabase. From your Supabase project's
# Settings → API. The anon key is safe to ship — RLS enforces access, this
# key alone grants nothing.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=

# ─── SERVER-ONLY (no VITE_ prefix; never referenced in browser code) ────
# Read these only inside a Supabase Edge Function — never in client code and
# never behind a VITE_ prefix. Set as Edge Function secrets in the Supabase
# dashboard, not in this file's real .env counterpart.
# SUPABASE_SERVICE_ROLE_KEY=      # bypasses RLS — edge functions only, auto-injected by Supabase
# ANTHROPIC_API_KEY=              # Ask Raag + document parsing
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLAN_PRO_MONTHLY=
# RAZORPAY_PLAN_PRO_YEARLY=
# RAZORPAY_PLAN_FAMILY_MONTHLY=
# RAZORPAY_PLAN_FAMILY_YEARLY=
# INTERNAL_QUEUE_SECRET=          # shared secret for the pg_cron retry queue, see supabase/migrations/0006_ingestion_queue.sql
# VITAL_API_KEY=                  # wearable aggregation (tryvital.io) — not yet integrated
# TERRA_API_KEY=                  # alternative wearable aggregator — not yet integrated
